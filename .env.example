# Anthropic API Key
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# WordPress 자동 포스팅 설정 (blog_poster.py 사용 시 필요)
# 워드프레스 사이트 주소 (끝에 슬래시 없이)
WP_URL=https://your-wordpress-site.com
# 워드프레스 로그인 사용자명
WP_USERNAME=your_wp_username
# 워드프레스 Application Password (일반 로그인 비밀번호 아님)
# 발급 방법: 워드프레스 관리자 > 사용자 > 프로필 > Application Passwords
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# SEO 노출 확인 도구 (seo_exposure_checker.py) 설정
# 아래 키들은 모두 선택 사항이며, 설정하지 않은 검색엔진은 확인을 건너뜁니다.

# 구글: Custom Search JSON API (https://developers.google.com/custom-search/v1/overview)
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_programmable_search_engine_id

# 빙: Bing Web Search API (Azure Cognitive Services / Bing Search v7)
BING_API_KEY=your_bing_search_api_key

# 네이버: 오픈API 검색 (https://developers.naver.com/apps/#/register)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 다음(카카오): 카카오 검색 API (https://developers.kakao.com/)
KAKAO_REST_API_KEY=your_kakao_rest_api_key
