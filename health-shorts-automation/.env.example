# ===== API Keys =====
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# OpenAI (대체 스크립트 생성용, 선택)
OPENAI_API_KEY=

# ===== YouTube Upload (선택) =====
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# ===== App Settings =====
# 기본 영상 길이(초): 30 / 45 / 60
DEFAULT_DURATION=45

# 기본 BGM 볼륨 (0.0 ~ 1.0)
BGM_VOLUME=0.10

# 렌더링 품질: low / medium / high
RENDER_QUALITY=medium
